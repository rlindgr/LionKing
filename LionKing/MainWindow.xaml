<Window x:Class="LionKing.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LionKing"
        mc:Ignorable="d"
        Title="MainWindow" Height="800" Width="1400">
    <Grid Margin="-1,-2,10,11" Width="NaN">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Border BorderBrush="Black" BorderThickness="1" HorizontalAlignment="Left" Height="219" Margin="325,7,0,0" VerticalAlignment="Top" Width="154"/>
        <Border BorderBrush="Black" BorderThickness="1" HorizontalAlignment="Left" Height="283" Margin="165,5,0,0" VerticalAlignment="Top" Width="154">
            <Label x:Name="lblLatinName" Content="Ange latinskt namn" HorizontalAlignment="Left" Height="41" Margin="6,95,0,0" VerticalAlignment="Top" Width="146"/>
        </Border>
        <Border BorderBrush="Black" BorderThickness="1" HorizontalAlignment="Left" Height="140" Margin="10,296,0,0" VerticalAlignment="Top" Width="466"/>
        <Border BorderBrush="Black" BorderThickness="1" HorizontalAlignment="Left" Height="220" Margin="5,6,0,0" VerticalAlignment="Top" Width="154">
            <Button x:Name="btnCreateClass" Content="Skapa" HorizontalAlignment="Center" Height="38" Margin="0,171,0,0" VerticalAlignment="Top" Width="126" Click="btnCreateClass_Click"/>
        </Border>
        <Border BorderBrush="Black" BorderThickness="1" HorizontalAlignment="Left" Height="192" Margin="20,501,0,0" VerticalAlignment="Top" Width="480"/>
        <Label Content="Ange namn (valfritt)" HorizontalAlignment="Left" Height="28" Margin="333,35,0,0" VerticalAlignment="Top" Width="133"/>
        <Label Content="Ange namn på art" HorizontalAlignment="Left" Height="26" Margin="169,37,0,0" VerticalAlignment="Top" Width="110"/>
        <Label Content="Ange namn på klass" HorizontalAlignment="Left" Height="30" Margin="11,43,0,0" VerticalAlignment="Top" Width="122"/>
        <Label Content="Skapa ny klass" HorizontalAlignment="Left" Height="33" Margin="6,12,0,0" VerticalAlignment="Top" Width="153" FontWeight="Bold" FontSize="16"/>
        <Label Content="Ta bort djur" HorizontalAlignment="Left" Height="24" Margin="24,322,0,0" VerticalAlignment="Top" Width="110" FontWeight="Bold"/>
        <Label Content="Ta bort art" HorizontalAlignment="Left" Height="24" Margin="24,370,0,0" VerticalAlignment="Top" Width="110" FontWeight="Bold"/>
        <Label Content="Ta bort klass" HorizontalAlignment="Left" Height="24" Margin="218,324,0,0" VerticalAlignment="Top" Width="112" FontWeight="Bold"/>
        <TextBox x:Name="txtCreateAnimal" HorizontalAlignment="Left" Height="35" Margin="332,64,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="137"/>
        <TextBox x:Name="txtCreateSpecies" HorizontalAlignment="Left" Height="33" Margin="172,65,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="140"/>
        <TextBox x:Name="txtCreateClass" HorizontalAlignment="Left" Height="39" Margin="13,74,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="133"/>
        <Label Content="Ta bort" HorizontalAlignment="Left" Height="31" Margin="18,296,0,0" VerticalAlignment="Top" Width="110" FontWeight="Bold" FontSize="16"/>
        <ComboBox x:Name="cbxRemoveAnimal" HorizontalAlignment="Left" Height="28" Margin="28,346,0,0" VerticalAlignment="Top" Width="174"/>
        <ComboBox x:Name="cbxRemoveSpecies" HorizontalAlignment="Left" Height="28" Margin="28,394,0,0" VerticalAlignment="Top" Width="174"/>
        <ComboBox x:Name="cbxRemoveClass" HorizontalAlignment="Left" Height="28" Margin="220,346,0,0" VerticalAlignment="Top" Width="174"/>
        <Button x:Name="btnRemove" Content="Ta bort" HorizontalAlignment="Left" Height="28" Margin="220,394,0,0" VerticalAlignment="Top" Width="174"/>
        <Label Content="Antal djur i djurriket" HorizontalAlignment="Left" Height="30" Margin="19,501,0,0" VerticalAlignment="Top" Width="175" FontWeight="Bold" FontSize="16"/>
        <ListBox x:Name="lstPopulation" HorizontalAlignment="Left" Height="148" Margin="194,533,0,0" VerticalAlignment="Top" Width="293" d:ItemsSource="{d:SampleData ItemCount=5}"/>
        <RadioButton x:Name="btnPopulation" Content="Total population" HorizontalAlignment="Left" Height="18" Margin="28,539,0,0" VerticalAlignment="Top" Width="105"/>
        <RadioButton x:Name="btnSortByClass" Content="Sortera efter djurklass" HorizontalAlignment="Left" Height="18" Margin="28,561,0,0" VerticalAlignment="Top" Width="138"/>
        <Label Content="Hitta" HorizontalAlignment="Left" Height="28" Margin="579,18,0,0" VerticalAlignment="Top" Width="85" FontWeight="Bold" FontSize="16"/>
        <Label Content="Ändra ett djur" HorizontalAlignment="Left" Height="28" Margin="761,461,0,0" VerticalAlignment="Top" Width="118" FontWeight="Bold" FontSize="16"/>
        <TextBox x:Name="txtGetAnimal" HorizontalAlignment="Left" Height="28" Margin="581,70,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="151"/>
        <Label Content="Sök efter ett djur" HorizontalAlignment="Left" Height="28" Margin="582,46,0,0" VerticalAlignment="Top" Width="150"/>
        <ListBox x:Name="lstAnimal" HorizontalAlignment="Left" Height="295" Margin="1169,51,0,0" VerticalAlignment="Top" Width="169" d:ItemsSource="{d:SampleData ItemCount=5}"/>
        <RadioButton x:Name="btnSortByAsc" Content="Sortera efter namn (fallande)" HorizontalAlignment="Left" Height="18" Margin="761,355,0,0" VerticalAlignment="Top" Width="172"/>
        <RadioButton x:Name="btnSortByDesc" Content="Sortera efter namn (stigande)" HorizontalAlignment="Left" Height="18" Margin="761,371,0,0" VerticalAlignment="Top" Width="174"/>
        <TextBox x:Name="txtCurrentName" HorizontalAlignment="Left" Height="28" Margin="1169,506,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="174"/>
        <TextBox x:Name="txtEditName" HorizontalAlignment="Left" Height="28" Margin="1169,556,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="174"/>
        <TextBox x:Name="txtCurrentSpecies" HorizontalAlignment="Left" Height="28" Margin="964,506,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="177"/>
        <TextBox x:Name="txtCurrentClass" HorizontalAlignment="Left" Height="28" Margin="761,506,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="172"/>
        <ComboBox x:Name="cbxEditSpecies" HorizontalAlignment="Left" Margin="964,554,0,0" VerticalAlignment="Top" Width="177" Height="29" RenderTransformOrigin="0.5,0.5">
            <ComboBox.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="-0.023"/>
                    <TranslateTransform/>
                </TransformGroup>
            </ComboBox.RenderTransform>
        </ComboBox>
        <ComboBox x:Name="btnEditClass" HorizontalAlignment="Left" Margin="763,555,0,0" VerticalAlignment="Top" Width="172" Height="29"/>
        <Button x:Name="btnEdit" Content="Ändra" HorizontalAlignment="Left" Height="39" Margin="1169,599,0,0" VerticalAlignment="Top" Width="174"/>
        <Label x:Name="lblCreateSpecies" Content="Skapa ny art" HorizontalAlignment="Left" Height="40" Margin="165,12,0,0" VerticalAlignment="Top" Width="154" FontWeight="Bold" FontSize="16"/>
        <ComboBox x:Name="cbxSelectClass" HorizontalAlignment="Left" Height="37" Margin="173,199,0,0" VerticalAlignment="Top" Width="140" DropDownOpened="cbxSelectClass_DropDownOpened"/>
        <Label Content="Ange klasstillhörighet" HorizontalAlignment="Left" Height="28" Margin="169,169,0,0" VerticalAlignment="Top" Width="128"/>
        <Button x:Name="btnCreateSpecies" Content="Skapa" HorizontalAlignment="Left" Height="31" Margin="172,243,0,0" VerticalAlignment="Top" Width="140"/>
        <Label Content="Skapa nytt djur" HorizontalAlignment="Left" Height="38" Margin="330,7,0,0" VerticalAlignment="Top" Width="146" FontWeight="Bold" FontSize="16"/>
        <ComboBox x:Name="cbxSelectSpecies" HorizontalAlignment="Left" Height="37" Margin="333,133,0,0" VerticalAlignment="Top" Width="133" DropDownOpened="cbxSelectSpecies_DropDownOpened"/>
        <Label Content="Välj arttillhörighet" HorizontalAlignment="Left" Height="29" Margin="332,105,0,0" VerticalAlignment="Top" Width="123"/>
        <Button x:Name="btnCreateAnimal" Content="Skapa" HorizontalAlignment="Left" Height="34" Margin="333,181,0,0" VerticalAlignment="Top" Width="133"/>
        <Button x:Name="btnGetAnimal" Content="Hämta ett djur" HorizontalAlignment="Left" Height="38" Margin="582,109,0,0" VerticalAlignment="Top" Width="150" Click="btnGetAnimal_Click_1"/>
        <ListBox x:Name="lstSpecies" HorizontalAlignment="Left" Height="294" Margin="964,52,0,0" VerticalAlignment="Top" Width="177" d:ItemsSource="{d:SampleData ItemCount=5}"/>
        <ListBox x:Name="lstAnimalClass" HorizontalAlignment="Left" Height="297" Margin="761,49,0,0" VerticalAlignment="Top" Width="174" d:ItemsSource="{d:SampleData ItemCount=5}"/>
        <Label x:Name="lblViewAnimalClass" Content="Djurklasser" HorizontalAlignment="Left" Height="32" Margin="761,12,0,0" VerticalAlignment="Top" Width="174" FontWeight="Bold"/>
        <Label x:Name="lblViewSpecies" Content="Arter" HorizontalAlignment="Left" Height="35" Margin="964,15,0,0" VerticalAlignment="Top" Width="177" FontWeight="Bold"/>
        <Label x:Name="lblViewAnimals" Content="Djur" HorizontalAlignment="Left" Height="36" Margin="1169,15,0,0" VerticalAlignment="Top" Width="169" FontWeight="Bold"/>
        <Button x:Name="btnViewAnimalClass" Content="Visa djurklasser" HorizontalAlignment="Left" Height="42" Margin="761,394,0,0" VerticalAlignment="Top" Width="174" Click="btnViewAnimalClass_Click"/>
        <Button x:Name="BtnViewSpecies" Content="Visa arter" HorizontalAlignment="Left" Height="42" Margin="964,394,0,0" VerticalAlignment="Top" Width="177" Click="BtnViewSpecies_Click"/>
        <Button x:Name="btnViewAnimal" Content="Visa djur" HorizontalAlignment="Left" Height="42" Margin="1169,394,0,0" VerticalAlignment="Top" Width="169" Click="btnViewAnimal_Click"/>
        <TextBox x:Name="txtLatinName" HorizontalAlignment="Left" Height="39" Margin="172,128,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="141"/>
    </Grid>
</Window>
