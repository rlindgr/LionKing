        <Label x:Name="lblCreateSpecies" Content="Skapa ny art" HorizontalAlignment="Left" Height="40" Margin="84,12,0,0" VerticalAlignment="Top" Width="154" FontWeight="Bold" FontSize="16" Grid.Column="1"/>
        <ComboBox x:Name="cbxSelectClass" HorizontalAlignment="Left" Height="37" Margin="92,133,0,0" VerticalAlignment="Top" Width="140" Grid.Column="1"/>
        <Label Content="Ange klasstillhörighet" HorizontalAlignment="Left" Height="28" Margin="88,99,0,0" VerticalAlignment="Top" Width="128" Grid.Column="1"/>
